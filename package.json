{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --fix .",
    "export": "NEXT_OUTPUT=export next build",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "deploy": "rm -rf out && npm run export && netlify deploy --prod"
  },
  "dependencies": {
    "@n8tb1t/use-scroll-position": "^4.0.0",
    "aos": "^2.3.4",
    "bootstrap": "^5.3.8",
    "classnames": "^2.5.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-collapsible": "^2.10.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-resize-detector": "^12.3.0",
    "react-responsive-carousel": "^3.2.23",
    "swiper": "^14.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "lint-staged": {
    "./**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "react-collapsible": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
