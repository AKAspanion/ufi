# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time.

# Show the reference agency's demo content (name, links, client case studies,
# testimonials, stats). Leave unset/false for neutral template content.
NEXT_PUBLIC_DEMO_CONTENT=false

# Your branding and links (all optional).
NEXT_PUBLIC_COMPANY_NAME=Your Company
NEXT_PUBLIC_CONTACT_URL=/#contact
NEXT_PUBLIC_BEHANCE_URL=
NEXT_PUBLIC_DRIBBBLE_URL=
